[Unit]
Description=Envia o digest matinal no Telegram

[Service]
Type=oneshot
User=controlador
WorkingDirectory=/home/controlador/curador-norturno
EnvironmentFile=/home/controlador/curador-noturno/.env
# Rota B do passo 3 (ambiente virtual):
# ExecStart=/home/admin/curador/.venv/bin/python -m curador.cli digest
# Rota A do passo 3 (pacotes do sistema): comente a linha acima e use esta
ExecStart=/usr/bin/python3 -m curador.cli digest
