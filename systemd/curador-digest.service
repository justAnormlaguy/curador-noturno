[Unit]
Description=Envia o digest matinal no Telegram

[Service]
Type=oneshot
User=SEU_USUARIO
WorkingDirectory=/home/SEU_USUARIO/curador-noturno
EnvironmentFile=/home/SEU_USUARIO/curador-noturno/.env
# Rota B do passo 3 do README (ambiente virtual):
# ExecStart=/home/SEU_USUARIO/curador-noturno/.venv/bin/python -m curador.cli digest
# Rota A do passo 3 do README (pacotes do sistema), a padrão:
ExecStart=/usr/bin/python3 -m curador.cli digest
