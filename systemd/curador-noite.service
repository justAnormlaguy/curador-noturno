[Unit]
Description=Curador noturno - coleta, triagem e resumo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=controlador
WorkingDirectory=/home/controlador/curador-noturno
EnvironmentFile=/home/controlador/curador-noturno/.env
# Rota B do passo 3 (ambiente virtual):
# ExecStart=/home/admin/curador/.venv/bin/python -m curador.cli noite
# Rota A do passo 3 (pacotes do sistema): comente a linha acima e use esta
ExecStart=/usr/bin/python3 -m curador.cli noite
# Se a noite inteira estourar 6h, algo está muito errado: o systemd mata o processo.
TimeoutStartSec=6h
Nice=10
StandardOutput=journal
StandardError=journal
