# ============================================================
# Curador Noturno — variáveis de ambiente
# Copie para .env (chmod 600) e ajuste os valores.
# ============================================================

# --- Gemini (Google AI Studio) ---
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo com plano gratuito. Triagem e resumo usam o mesmo.
GEMINI_MODELO=gemini-3.1-flash-lite

# Chamadas por minuto. Fique abaixo do RPM free do seu projeto
# (AI Studio → Rate limits). 0 = sem espaçamento.
GEMINI_RPM=10

# Segundos por chamada e tentativas em erro 429/5xx.
GEMINI_TIMEOUT=60
GEMINI_TENTATIVAS=4

# Nível de raciocínio: minimal | low | medium | high (vazio = padrão da API).
# Triagem e resumo curto não precisam de mais que minimal.
GEMINI_PENSAMENTO=minimal

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
